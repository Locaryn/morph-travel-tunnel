{
  "$schema": "https://locaryn.dev/schema/plugin.json/v0.1",
  "apiVersion": "0.1",
  "name": "extension-travel-tunnel",
  "version": "1.1.0",
  "description": "Mode distant sécurisé avec tunnels sortants chiffrés (Cloudflare, ngrok, devtunnel) et appairage QR code pour mobile.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/extension-travel-tunnel",
  "repository": "https://github.com/Locaryn/extension-travel-tunnel",
  "keywords": [
    "travel-tunnel",
    "remote-mode",
    "tunnels",
    "cloudflare",
    "ngrok",
    "qr-pairing"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le gestionnaire de tunnels distants chiffrés."
    },
    "network": {
      "reason": "Établir des tunnels HTTPS sortants et générer des jetons d'accès."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "travel-tunnel"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "remote-settings-studio",
        "slot": "studio.tabs",
        "order": 35,
        "label": "Tunnels & Accès Distant",
        "icon": "cloud",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-remote-panel",
        "hint": "Configuration des tunnels Cloudflare/ngrok et appairage mobile"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  }
}
