{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-travel-tunnel",
  "version": "1.0.0-beta.1",
  "description": "Rendre la machine joignable de l'extérieur par un tunnel sortant (Cloudflare, ngrok, tunnels Microsoft), sans rien ouvrir sur la box.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-travel-tunnel",
  "repository": "https://github.com/Locaryn/morph-travel-tunnel",
  "keywords": [
    "travel-tunnel",
    "remote-mode",
    "tunnels",
    "cloudflare",
    "ngrok",
    "qr-pairing"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le gestionnaire de tunnels distants chiffrés."
    },
    "network": {
      "reason": "Établir des tunnels HTTPS sortants et générer des jetons d'accès."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "travel-tunnel"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "remote-settings-studio",
        "slot": "studio.tabs",
        "order": 35,
        "label": "Tunnels & Accès Distant",
        "icon": "cloud",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-remote-panel",
        "hint": "Configuration des tunnels Cloudflare/ngrok et appairage mobile"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "1.0.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (Pre-release) — non testée par des utilisateurs",
      "tag": "v1.0.0-beta.1",
      "released_at": "2026-08-28"
    },
    {
      "version": "0.9.0",
      "is_beta": false,
      "summary": "Version de référence stable",
      "tag": "v0.9.0",
      "released_at": "2026-08-20"
    },
    {
      "version": "0.8.5",
      "is_beta": false,
      "summary": "Version précédente stable",
      "tag": "v0.8.5",
      "released_at": "2026-08-15"
    },
    {
      "version": "0.8.0",
      "is_beta": false,
      "summary": "Version initiale du socle",
      "tag": "v0.8.0",
      "released_at": "2026-08-01"
    }
  ]
}
